# server configuration
PORT="4001"
NODE_ENV="development"
LOG_LEVEL="info"

# database configuration
# postgresql connection string
DATABASE_URL="postgresql://postgres:your_password@localhost:5433/your_database_name?schema=public"

# redis configuration 
# redis connection string with password
# format: redis://:password@host:port
REDIS_URL="redis://:your_password@localhost:6379"

# CORS configuration
# comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:4000,http://localhost:4001"

# OTP configuration
# OTP expiry time in seconds (300 seconds = 5 minutes)
OTP_TTL="300"

# sendgrid api key for email notification
# get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="your_sendgrid_api_key"
